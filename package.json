{
  "name": "trimchat",
  "version": "0.1.0",
  "description": "Trim chat history to fit a token budget without breaking it. Drops the oldest turns first, keeps system prompts and tool call/result pairs together, and works with OpenAI, Anthropic and Vercel AI SDK messages. Zero dependencies.",
  "keywords": [
    "llm",
    "chat",
    "chat-history",
    "context-window",
    "token",
    "tokens",
    "token-budget",
    "truncate",
    "trim",
    "conversation",
    "memory",
    "openai",
    "anthropic",
    "claude",
    "ai-sdk",
    "prompt"
  ],
  "homepage": "https://github.com/acus9345/trimchat#readme",
  "bugs": {
    "url": "https://github.com/acus9345/trimchat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acus9345/trimchat.git"
  },
  "license": "MIT",
  "author": "acus9345 <acus9345@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prelint": "npm run build",
    "lint": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
